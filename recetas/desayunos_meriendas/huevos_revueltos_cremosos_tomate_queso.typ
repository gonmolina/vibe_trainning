#import "../_template.typ": receta

#receta(
  titulo: "Huevos Revueltos Proteicos y Cremosos con Tomate, Queso Magro y Orégano",
  categoria: "Almuerzo Rápido / Merienda Proteica",
  momento: "Almuerzo rápido (con tostadas o arroz) o Merienda saciante en días de fuerza/descanso",
  tiempo_prep: "8 min",
  porciones: "1 porción",
  calorias_porcion: "~310 kcal",
  macros: (
    prot: "26 g",
    carbs: "6 g",
    grasas: "19 g"
  ),
  ingredientes: (
    [3 huevos enteros (o 2 huevos enteros + 1 clara si se busca bajar grasa).],
    [1 tomate perita o redondo chico, cortado en cubitos.],
    [30 a 40 g de queso blanco magro / descremado firme (tipo Port Salut light o ricota magra).],
    [Rocío vegetal (para la sartén, sin aceite agregado).],
    [Condimentos: sal, orégano, pimienta negra y una pizca de pimentón dulce.],
    [Opcional para almuerzo: 2 tostadas de pan o 1 taza de arroz para sumar carbohidratos.]
  ),
  pasos: (
    [En un bowl chico o taza, cascar los 3 huevos, agregar la sal, pimienta y orégano. Batir enérgicamente con tenedor durante 30 segundos hasta espumar.],
    [Calentar una sartén antiadherente a fuego medio-bajo con un toque de rocío vegetal.],
    [Saltear los cubitos de tomate durante 1 minuto para que suelten su jugo y concentren sabor.],
    [Bajar el fuego a mínimo y verter los huevos batidos sobre la sartén.],
    [Revolver suave y continuamente con espátula de silicona desde los bordes hacia el centro (fuego bajo para evitar que se sequen o quemen).],
    [Apenas empiecen a coagular pero sigan húmedos y brillantes, agregar los cubitos de queso magro y retirar del fuego inmediatamente (el calor residual terminará de fundir el queso).],
    [Servir caliente espolvoreado con orégano fresco.]
  ),
  tips: (
    [Técnica de cremosidad sin crema: cocinar a fuego mínimo y retirar cuando aún estén brillantes evita que el huevo quede gomoso y seco sin sumar calorías de manteca.],
    [Para Días de Running: sumar 2 tostadas de pan o 1 taza de arroz blanco/papa para transformarlo en un almuerzo completo con glucógeno para la tarde.],
    [Para Días de Fuerza o Descanso: comer solo con el tomate y queso para una comida saciante de 26g de proteína con carbohidratos mínimos.]
  )
)
